# Copiar este archivo a .env y configurar los valores

# Puerto del servidor (Railway/Render asignan PORT automáticamente)
PORT=3000

# ── BASE DE DATOS MySQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_contraseña_mysql
DB_NAME=quetzalzin

# Para servicios en la nube (Railway, PlanetScale, etc.) usa la URL completa:
# DATABASE_URL=mysql://usuario:contraseña@host:3306/quetzalzin

# ── SEGURIDAD ────────────────────────────────────────────
# Secreto para JWT — cambiar en producción por una cadena larga y aleatoria
JWT_SECRET=quetzalzin-cambia-este-secreto-en-produccion

# ── WHATSAPP ─────────────────────────────────────────────
# Número sin + ni espacios, con código de país
WHATSAPP_NUMBER=5215626277691

# ── EMAIL (opcional) ──────────────────────────────────────
# Si no se configura, no se envían correos automáticos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
EMAIL_FROM=Quetzalzin <tu-correo@gmail.com>
